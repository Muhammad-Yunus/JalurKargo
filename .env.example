# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL Database Credentials
DB_HOST=""
DB_PORT="5432"
DB_NAME="postgres"
DB_USER=""
DB_PASSWORD=""

# AUTH_SECRET: Server-side HMAC secret for signing user session tokens
AUTH_SECRET=""

# INGEST_API_KEY: Separate API Key for External Systems Ingest API (/api/ingest/*)
INGEST_API_KEY=""

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform JavaScript API key for live map rendering
VITE_GOOGLE_MAPS_API_KEY=""
